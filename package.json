{
  "name": "majin",
  "version": "0.2.0",
  "private": true,
  "description": "Browser and desktop terminal powered by xterm.js, WebSocket and PTY",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-yoshiki/majin.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@majin/web --filter=@majin/server",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm lint:js && pnpm lint:rust",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all --check",
    "test": "cargo test --workspace",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "check:fix": "pnpm lint:fix && pnpm format",
    "verify": "pnpm check && pnpm test",
    "dev:desktop": "turbo run dev --filter=@majin/desktop",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:web": "turbo run build --filter=@majin/server",
    "build:desktop": "turbo run build --filter=@majin/desktop",
    "lint:js": "oxlint .",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "generate:protocol": "turbo run generate --filter=@majin/protocol-rs",
    "test:e2e": "node scripts/smoke-test.mjs",
    "clean": "turbo run clean && cargo clean"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
