{
  "name": "@majin/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Tauri desktop app; talks to a local PTY over IPC instead of a WebSocket",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "icon": "node scripts/generate-icon.mjs && tauri icon app-icon.png",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@majin/protocol": "workspace:*",
    "@majin/terminal-ui": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@majin/tsconfig": "workspace:*",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
